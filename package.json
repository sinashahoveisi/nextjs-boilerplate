{
  "name": "next-boilerplate",
  "description": "a boilerplate for nextjs projects",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ./src",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,json,jsx,css}\"",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:ui": "vitest --ui --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test-storybook": "vitest --project=storybook",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "pretest:e2e": "playwright install",
    "pretest:e2e:ui": "playwright install",
    "pretest:e2e:debug": "playwright install",
    "pretest:e2e:headed": "playwright install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "axios-auth-refresh": "^5.0.2",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.8",
    "next": "^16.3.1",
    "nextjs-toploader": "^3.9.17",
    "qs": "^6.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-toastify": "^11.1.0",
    "sharp": "^0.35.3",
    "yup": "^1.7.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.2.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webpack": "^5.109.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
